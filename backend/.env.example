# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=whatsapp_platform
DB_USER=postgres
DB_PASSWORD=postgres123
DB_SYNC=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES=30d

# Seed (used only by `npm run seed`)
SEED_TENANT_NAME=Default Medical Center
SEED_TENANT_SLUG=default
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Meta WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Fallback token used when a whatsapp_numbers row's access_token_secret_ref
# doesn't resolve to an env var of its own. For real multi-number setups,
# set access_token_secret_ref on each number to a distinct env var name
# (e.g. META_ACCESS_TOKEN_MAIN_LINE=...) so each number's token is looked up
# independently — see WhatsappNumbersService.resolveAccessToken().
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_API_VERSION=v20.0

# AI Layer — chat completion (Anthropic doesn't have a public embeddings
# endpoint, so it can only serve AI_PROVIDER, not EMBEDDING_PROVIDER)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# Embeddings — OpenAI text-embedding-3-small outputs 1536 dims, matching the
# embeddings.vector column (VECTOR(1536)) exactly with no extra config.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# MinIO (S3-compatible) — inbound WhatsApp media storage. Matches docker-compose.yml.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=whatsapp-media
